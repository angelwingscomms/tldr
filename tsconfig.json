{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "@cloudflare/workers-types"],
		"paths": {
			"$lib": ["./src/lib/index.js"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib/index.js"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.*", "src/**/*.spec.*"]
}
